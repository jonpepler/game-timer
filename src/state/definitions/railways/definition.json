  "setupSteps": [
    {
      "id": "modules",
      "label": "Modules",
      "kind": {
        "type": "multi-toggle",
        "optionCategory": "expansion",
        "defaultSelectedIds": ["base"],
        "optionIds": ["base", "landmarkTiles", "metropolitan", "events"]
      }
    },
    {
      "id": "length",
      "label": "Game length",
      "description": "The Short Game plays four cycles and the Long Game six. A cycle is a Stock Round, two Operating Rounds and a Merger Round. The predicted finish uses this.",
      "kind": {
        "type": "select-one",
        "optionCategory": "gameLength",
        "defaultOptionId": "long",
        "optionIds": ["short", "long"]
      }
    },
    {
      "id": "seating",
      "label": "Seat players",
      "kind": {
        "type": "seat-players",
        "minPlayers": 2,
        "maxPlayers": 7,
        "defaultPlayerCount": 4
      }
    },
    {
      "id": "map",
      "label": "Build the map",
      "description": "Pick a random first player. Going clockwise, take turns placing map tiles following the map-building rules. With the Landmark tiles module, shuffle in landmark tiles: 3 for a Long game, 2 for a Short game.",
      "kind": {
        "type": "info"
      }
    },
    {
      "id": "charters",
      "label": "Companies and trains",
      "description": "Lay out the Minor Company charters in 3 columns of 4 (2 columns for a Short game, leaving out Adaptive, Bridging, Overnight and Spacious). Only the bottom charter of each column can be launched. With fewer than 4 players, remove the extra 3- and 6-trains marked for 4 or more players.",
      "kind": {
        "type": "info"
      }
    },
    {
      "id": "capital",
      "label": "Starting capital",
      "description": "Each player takes 450 with 2 players, 300 with 3, 275 with 4, or 220 with 5. In the Landmarks 6-7 Player Mode, 265 with 6 or 225 with 7.",
      "kind": {
        "type": "info"
      }
    },
    {
      "id": "events",
      "label": "Events (Landmarks)",
      "description": "Only with the Events module: build the event stack with Town Chronicle cards above New City Herald cards, 2 of each for a Short game or 3 of each for a Long game. When an event adds a round, pick it when the timer asks which round comes next.",
      "kind": {
        "type": "info"
      }
    },
    {
      "id": "priority",
      "label": "Priority",
      "description": "Choose who holds the priority marker and takes the first Stock Round turn. The rules choose at random.",
      "kind": {
        "type": "select-lead",
        "allowRandom": true,
        "defaultLead": "random"
      }
    }
  ]
}
