{
  "schemaVersion": 1,
  "id": "root",
  "name": "Root",
  "description": "Asymmetric woodland strategy by Leder Games. First faction to 30 wins.",
  "contentSource": "./modules.json",
  "defaultExpectedTurns": 32,
  "turnsPerPlayer": 8,
  "defaultAverageSeconds": 240,
  "maxPlayers": 6,
  "playerVisualFrom": "faction",
  "playerSubheadingFrom": "faction",
  "score": {
    "displayStyle": "linearTrack",
    "min": 0,
    "max": 30,
    "increment": 1,
    "victory": { "type": "firstToMax" },
    "milestones": [
      { "atScore": 4, "label": "Trigger your hireling effect." },
      { "atScore": 8, "label": "Trigger your hireling effect." },
      { "atScore": 12, "label": "Trigger your hireling effect." }
    ]
  },
  "setupSteps": [
    {
      "id": "expansions",
      "label": "Expansions in this game",
      "kind": {
        "type": "multi-toggle",
        "optionCategory": "expansion",
        "defaultSelectedIds": [
          "base",
          "riverfolk",
          "underworld",
          "marauders",
          "homeland"
        ],
        "optionIds": ["base", "riverfolk", "underworld", "marauders", "homeland"]
      }
    },
    {
      "id": "map",
      "label": "Map",
      "kind": {
        "type": "select-one",
        "optionCategory": "map",
        "allowRandom": true,
        "defaultOptionId": "autumn",
        "optionIds": ["autumn", "winter", "lake", "mountain", "marsh", "gorge"]
      }
    },
    {
      "id": "deck",
      "label": "Deck",
      "kind": {
        "type": "select-one",
        "optionCategory": "deck",
        "allowRandom": true,
        "defaultOptionId": "base",
        "optionIds": ["base", "exiles", "squires"]
      }
    },
    {
      "id": "landmarks",
      "label": "Landmarks",
      "kind": {
        "type": "select-count",
        "min": 0,
        "max": 2,
        "defaultValue": 0,
        "allowRandom": true
      }
    },
    {
      "id": "seating",
      "label": "Seat players",
      "kind": {
        "type": "seat-players",
        "minPlayers": 1,
        "maxPlayers": 6,
        "defaultPlayerCount": 4
      }
    },
    {
      "id": "hirelings",
      "label": "Hirelings",
      "kind": {
        "type": "deal-random",
        "optionCategory": "hireling",
        "count": 3,
        "optional": true,
        "optionIds": [
          "patrol", "dynasty", "uprising", "exile",
          "prophets", "flotilla", "bandits",
          "expedition", "spies", "protector",
          "flameBearers", "vaultKeepers", "band",
          "advocates", "roamers", "farmers"
        ]
      }
    },
    {
      "id": "hireling-setup",
      "label": "Set up hirelings",
      "description": "Each player resolves one hireling in turn (alphabetical order).",
      "kind": {
        "type": "dealt-resolve",
        "sourceStepId": "hirelings"
      }
    },
    {
      "id": "faction",
      "label": "Faction",
      "kind": {
        "type": "player-pick",
        "mode": "turn-based",
        "optionCategory": "faction",
        "allowRandom": true,
        "optionIds": [
          "marquise",
          "eyrie",
          "alliance",
          "vagabond",
          "lizards",
          "riverfolk",
          "duchy",
          "corvids",
          "hundreds",
          "keepers",
          "lilypad",
          "twilight",
          "knaves"
        ],
        "constraints": [
          {
            "type": "mutually-exclusive",
            "optionIds": ["vagabond", "knaves"]
          }
        ]
      }
    }
  ]
}
