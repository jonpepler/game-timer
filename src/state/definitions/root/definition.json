{
  "schemaVersion": 1,
  "id": "root",
  "name": "Root",
  "description": "Asymmetric woodland strategy by Leder Games. First faction to 30 wins.",
  "contentSource": "./modules.json",
  "defaultExpectedTurns": 40,
  "defaultAverageSeconds": 240,
  "maxPlayers": 6,
  "playerVisualFrom": "faction",
  "playerSubheadingFrom": "faction",
  "score": {
    "displayStyle": "linearTrack",
    "min": 0,
    "max": 30,
    "increment": 1,
    "victory": { "type": "firstToMax" }
  },
  "setupSteps": [
    {
      "id": "expansions",
      "label": "Expansions in this game",
      "description": "Toggle the modules you have at the table. Downstream steps hide any options that belong to an unchecked module.",
      "kind": {
        "type": "multi-toggle",
        "optionCategory": "expansion",
        "defaultSelectedIds": ["base"],
        "optionIds": ["base", "riverfolk", "underworld", "marauders", "homeland"]
      }
    },
    {
      "id": "map",
      "label": "Map",
      "description": "Each map changes how clearings link and a few global rules.",
      "kind": {
        "type": "select-one",
        "optionCategory": "map",
        "allowRandom": true,
        "defaultOptionId": "autumn",
        "optionIds": ["autumn", "winter", "lake", "mountain", "marsh", "gorge"]
      }
    },
    {
      "id": "deck",
      "label": "Deck",
      "description": "Swap the card mix for variety.",
      "kind": {
        "type": "select-one",
        "optionCategory": "deck",
        "allowRandom": true,
        "defaultOptionId": "base",
        "optionIds": ["base", "exiles", "squires"]
      }
    },
    {
      "id": "landmarks",
      "label": "Landmarks",
      "description": "Map-side scoring perks. Place 0–2 landmark cards.",
      "kind": {
        "type": "select-count",
        "min": 0,
        "max": 2,
        "defaultValue": 0,
        "allowRandom": true
      }
    },
    {
      "id": "seating",
      "label": "Seat players",
      "description": "Enter player names and drag to reorder. Seating is the turn order for the faction picker.",
      "kind": {
        "type": "seat-players",
        "minPlayers": 1,
        "maxPlayers": 6,
        "defaultPlayerCount": 4
      }
    },
    {
      "id": "hirelings",
      "label": "Hirelings",
      "description": "Bot-driven allies. Shuffle all hirelings, deal three (or skip to play without).",
      "kind": {
        "type": "deal-random",
        "optionCategory": "hireling",
        "count": 3,
        "optional": true,
        "optionIds": [
          "patrol", "dynasty", "uprising", "exile",
          "prophets", "flotilla", "bandits",
          "expedition", "spies", "protector",
          "flameBearers", "vaultKeepers", "band",
          "advocates", "roamers", "farmers"
        ]
      }
    },
    {
      "id": "draft",
      "label": "Draft factions",
      "description": "Players choose factions from a shared pool in counterclockwise order.",
      "kind": {
        "type": "toggle",
        "defaultValue": false
      }
    },
    {
      "id": "faction",
      "label": "Faction",
      "description": "Each seated player claims one faction. The Vagabond and Knaves of the Deepwood cannot both be in the same game.",
      "kind": {
        "type": "player-pick",
        "mode": "host-only",
        "optionCategory": "faction",
        "allowRandom": true,
        "optionIds": [
          "marquise",
          "eyrie",
          "alliance",
          "vagabond",
          "lizards",
          "riverfolk",
          "duchy",
          "corvids",
          "hundreds",
          "keepers",
          "lilypad",
          "twilight",
          "knaves"
        ],
        "constraints": [
          {
            "type": "mutually-exclusive",
            "optionIds": ["vagabond", "knaves"]
          }
        ]
      }
    }
  ]
}
