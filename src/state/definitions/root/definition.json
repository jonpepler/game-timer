{
  "schemaVersion": 1,
  "id": "root",
  "name": "Root",
  "description": "Asymmetric woodland strategy by Leder Games. First faction to 30 wins.",
  "contentSource": "./modules.json",
  "defaultExpectedTurns": 32,
  "turnsPerPlayer": 8,
  "defaultAverageSeconds": 240,
  "maxPlayers": 6,
  "playerVisualFrom": "faction",
  "playerSubheadingFrom": "faction",
  "score": {
    "displayStyle": "linearTrack",
    "min": 0,
    "max": 30,
    "increment": 1,
    "victory": {
      "type": "firstToMax"
    },
    "milestones": [
      {
        "atScore": 4,
        "label": "Choose a hireling and roll for control.",
        "fireOnce": true,
        "marker": {
          "display": "H"
        }
      },
      {
        "atScore": 8,
        "label": "Choose a hireling and roll for control.",
        "fireOnce": true,
        "marker": {
          "display": "H"
        }
      },
      {
        "atScore": 12,
        "label": "Choose a hireling and roll for control.",
        "fireOnce": true,
        "marker": {
          "display": "H"
        }
      }
    ]
  },
  "setupSteps": [
    {
      "id": "expansions",
      "label": "Expansions in this game",
      "kind": {
        "type": "multi-toggle",
        "optionCategory": "expansion",
        "defaultSelectedIds": [
          "base",
          "riverfolk",
          "underworld",
          "marauders",
          "homeland",
          "vagabondPack",
          "landmarksPack"
        ],
        "optionIds": [
          "base",
          "riverfolk",
          "underworld",
          "marauders",
          "homeland",
          "vagabondPack",
          "landmarksPack"
        ]
      }
    },
    {
      "id": "map",
      "label": "Map",
      "kind": {
        "type": "select-one",
        "optionCategory": "map",
        "allowRandom": true,
        "defaultOptionId": "autumn",
        "optionIds": ["autumn", "winter", "lake", "mountain", "marsh", "gorge"]
      }
    },
    {
      "id": "deck",
      "label": "Deck",
      "kind": {
        "type": "select-one",
        "optionCategory": "deck",
        "allowRandom": true,
        "defaultOptionId": "base",
        "optionIds": ["base", "exiles", "squires"]
      }
    },
    {
      "id": "seating",
      "label": "Seat players",
      "kind": {
        "type": "seat-players",
        "minPlayers": 1,
        "maxPlayers": 6,
        "defaultPlayerCount": 4
      }
    },
    {
      "id": "hirelings",
      "label": "Hirelings",
      "kind": {
        "type": "deal-random",
        "optionCategory": "hireling",
        "count": 3,
        "optional": true,
        "demote": {
          "thresholds": [
            { "minSeats": 3, "count": 1 },
            { "minSeats": 4, "count": 2 },
            { "minSeats": 5, "count": 3 }
          ]
        },
        "optionIds": [
          "patrol",
          "dynasty",
          "uprising",
          "exile",
          "prophets",
          "flotilla",
          "bandits",
          "expedition",
          "spies",
          "protector",
          "flameBearers",
          "vaultKeepers",
          "band",
          "advocates",
          "roamers",
          "farmers"
        ]
      }
    },
    {
      "id": "hireling-setup",
      "label": "Set up hirelings",
      "description": "Each player resolves one hireling in turn (alphabetical order).",
      "kind": {
        "type": "dealt-resolve",
        "sourceStepId": "hirelings"
      }
    },
    {
      "id": "landmarks",
      "label": "Landmarks",
      "description": "Shuffle the landmarks you're playing with and deal one.",
      "kind": {
        "type": "deal-random",
        "optionCategory": "landmark",
        "count": 1,
        "optional": true,
        "optionIds": [
          "the-tower",
          "the-ferry",
          "black-market",
          "lost-city",
          "legendary-forge",
          "elder-treetop",
          "mousehold",
          "foxburrow",
          "rabbittown"
        ]
      }
    },
    {
      "id": "landmark-setup",
      "label": "Set up landmarks",
      "description": "The last player in turn order sets up the drawn landmark as shown on its card.",
      "kind": {
        "type": "info"
      }
    },
    {
      "id": "draw-hands",
      "label": "Draw 5 cards",
      "description": "If you are playing with two players, remove all four dominance cards from the deck. Shuffle the deck. Each player draws five cards.",
      "kind": {
        "type": "info"
      }
    },
    {
      "id": "faction",
      "label": "Faction",
      "kind": {
        "type": "player-pick",
        "mode": "turn-based",
        "optionCategory": "faction",
        "allowRandom": true,
        "optionIds": [
          "marquise",
          "eyrie",
          "alliance",
          "vagabond",
          "lizards",
          "riverfolk",
          "duchy",
          "corvids",
          "hundreds",
          "keepers",
          "lilypad",
          "twilight",
          "knaves"
        ],
        "constraints": [
          {
            "type": "mutually-exclusive",
            "optionIds": ["vagabond", "knaves"]
          }
        ]
      }
    },
    {
      "id": "starting-hands",
      "label": "Choose Starting Hands",
      "description": "Each player chooses three cards in their hand to keep and puts the other two cards face down on the shared deck. When finished, shuffle the shared deck.",
      "kind": {
        "type": "info"
      }
    }
  ]
}
